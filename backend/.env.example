# --- Django ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# Every address the site is reached by. With no domain, that's localhost
# plus the server's IP — e.g. 127.0.0.1,localhost,13.51.72.9
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.development

# Full https://host origin(s) allowed to submit django-admin logins etc.
# Only matters in production, behind Caddy's TLS termination — set this
# to match SITE_ADDRESS in .env.prod, e.g.
# CSRF_TRUSTED_ORIGINS=https://15-240-170-199.sslip.io
CSRF_TRUSTED_ORIGINS=

# --- Database (Postgres) ---
DB_NAME=kopala_icr
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- CORS ---
# Local dev: the public site and the admin dashboard (kopalaicr-admin)
# each run on their own Vite dev port, cross-origin from this backend —
# 5173 by default (Vite picks the next free port if that's taken; the
# admin app, started separately, typically lands around 5177+).
# Production: the frontend's real domain MUST be added here, or every API
# call from it fails with a CORS error in the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179

# --- Email (Gmail SMTP) ---
# Not needed in local dev — EMAIL_BACKEND defaults to the console backend
# there (see config/settings/development.py), so emails just print.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# The public backend URL — used to build the webhook callback URL sent to
# the payment gateway, e.g. https://15-240-170-199.sslip.io
PUBLIC_BASE_URL=
# The public site's URL — used for the "track your registration" link and
# the team dashboard login link in outgoing emails, e.g.
# https://www.kopalaicr.example
PUBLIC_SITE_URL=
# Shown in the footer of outgoing emails.
EVENT_CONTACT_PHONE=
EVENT_CONTACT_EMAIL=

# --- SMS (pluggable — see apps/notifications/sms.py) ---
SMS_BACKEND=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# --- Payment gateway ---
# "console" (default) simulates payments locally, no credentials needed —
# see apps/payments/gateways/console.py. Set to "lipila" once real
# sandbox/production keys are available below.
PAYMENT_GATEWAY=console

LIPILA_ENVIRONMENT=sandbox
LIPILA_SANDBOX_API_KEY=
LIPILA_PRODUCTION_API_KEY=
LIPILA_WEBHOOK_SECRET=

# --- Bank transfer details shown to registrants (Bank Transfer payment method) ---
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SORT_CODE=
BANK_SWIFT_CODE=

# --- This event ---
EVENT_NAME=Kopala ICR 2026
EVENT_DATE=3 October 2026
EVENT_LOCATION=Nchanga Stadium, Chingola, Copperbelt Province

# Runners beyond this count on a team's roster owe the extra-runner fee
# instead of being covered by the team's base entry fee. Matches
# RELAY_TEAM_SIZE in the frontend (src/types.ts) — only change this if
# that constant changes too.
TEAM_FREE_RUNNER_LIMIT=8
